# Create /data/hongbao/scanner.env on the machine; keep it private (chmod 600).
# A local Linux-compatible controller and the authorized proxy configuration are required.
SCANNER_CLASH_API=http://127.0.0.1:9090
SCANNER_PROXY=http://127.0.0.1:7890
SCANNER_CLASH_GROUP=scan-exits
SCANNER_CLASH_SECRET=
SCANNER_IP_NETWORK_RETRY=1
